---
import { ArrowLeft, Store } from "lucide-react"
import { PlaceholderArt } from "@/components/brand/PlaceholderArt"
import AddToCart from "./AddToCart"
import { site, tr, t, strings, href, langInfo, specialPageHref, productsData, languages, type FlatPage } from "@/lib/site"

interface Props {
  lang: string
  page: FlatPage
  product: any
}
const { lang, page, product } = Astro.props
const locale = langInfo(lang).locale
const storeHref = href(lang, page.path)
const category = productsData.categories.find((c: any) => c.id === product.category)
const image = product.images?.[0] ?? { motif: category?.motif ?? "church", tone: "stone" }
const allLangs = (v: any) => Object.fromEntries(languages.map((l) => [l.code, tr(v, l.code)]))
const variants = product.variants.map((v: any) => ({ id: v.id, label: tr(v.label, lang), labels: allLangs(v.label), price: v.price, stock: v.stock }))
const s = strings(lang, ["option", "outOfStock", "lowStock", "inStock", "addToCart", "addedToCart", "viewCart", "quantity", "decrease", "increase"])
---

<div class="border-b border-border bg-stone-50">
  <div class="container-mission py-4">
    <a href={storeHref} class="inline-flex items-center gap-1.5 text-sm text-ink-600 hover:text-blue">
      <ArrowLeft aria-hidden="true" className="size-4 rtl:rotate-180" />
      {t("backToStore", lang)}
    </a>
  </div>
</div>
<div class="container-mission grid gap-10 py-10 md:grid-cols-2 md:py-16 lg:gap-16">
  <div class="min-w-0">
    <div class="aspect-square overflow-hidden rounded-[1.75rem] border border-border">
      <PlaceholderArt motif={image.motif} tone={image.tone} src={image.src} alt={tr(image.alt, lang)} label={t("sampleImage", lang)} iconSize="38%" />
    </div>
  </div>
  <div class="min-w-0">
    <a href={`${storeHref}?category=${product.category}`} class="eyebrow hover:underline">{tr(category?.label, lang)}</a>
    <h1 class="mt-3 text-4xl leading-tight text-ink md:text-5xl">{tr(product.title, lang)}</h1>
    <div aria-hidden="true" class="hairline-gold-start mt-5 w-32"></div>
    <p class="mt-5 text-lg leading-relaxed text-ink-600">{tr(product.summary, lang)}</p>
    <div class="mt-8">
      <AddToCart
        client:load
        productId={product.id}
        titles={allLangs(product.title)}
        variants={variants}
        pickupOnly={!!product.pickupOnly}
        motif={image.motif}
        locale={locale}
        currency={site.checkout.currency}
        cartHref={specialPageHref("cart", lang) ?? storeHref}
        s={s}
      />
    </div>
    {
      product.pickupOnly && (
        <p class="mt-6 flex items-center gap-2 text-sm text-ink-600">
          <Store aria-hidden="true" className="size-4 text-gold" />
          {t("pickupOnly", lang)}
        </p>
      )
    }
    <div class="prose-mission mt-8 border-t border-border pt-8 leading-relaxed text-ink-700">
      {product.description.map((p: any) => <p>{tr(p, lang)}</p>)}
    </div>
  </div>
</div>
