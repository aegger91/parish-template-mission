---
interface Props {
  id: string
  eyebrow?: string
  title?: string
  intro?: string
  tone?: "white" | "stone"
  headingLevel?: 2 | 3
  wide?: boolean
  class?: string
}
const { id, eyebrow, title, intro, tone = "white", class: className } = Astro.props
const headingId = title ? `${id}-heading` : undefined
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={["py-16 md:py-24", tone === "stone" ? "bg-stone-50" : "bg-white", className]}
>
  <div class="container-mission">
    {
      (eyebrow || title || intro) && (
        <div class="mb-10 max-w-2xl md:mb-12">
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          {title && (
            <h2 id={headingId} class="text-3xl leading-tight text-ink md:text-[2.6rem]">
              {title}
            </h2>
          )}
          {intro && <p class="mt-4 text-lg leading-relaxed text-ink-600">{intro}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
