---
import { ArrowRight } from "lucide-react"
import SectionShell from "./SectionShell.astro"
import { PlaceholderArt } from "@/components/brand/PlaceholderArt"
import { tr, t, href, isPageEnabled, type SectionNode, type FlatPage } from "@/lib/site"
interface Props {
  lang: string
  section: SectionNode
  page: FlatPage
}
const { lang, section, page } = Astro.props
const children = (page.node.children ?? []).filter((c) => isPageEnabled(c) && c.showInNav !== false)
const cardImages = [
  "/images/samples/church-exterior-1.webp",
  "/images/samples/iconostasis.webp",
  "/images/samples/candles.webp",
  "/images/samples/parish-gathering.webp",
]
---

{
  children.length > 0 && (
    <SectionShell id={section.id} title={tr(section.title, lang)} tone={(section.tone as any) ?? "white"}>
      <ul class:list={["grid gap-5 sm:grid-cols-2", children.length >= 4 ? "lg:grid-cols-4" : "lg:grid-cols-3"]}>
        {children.map((child, index) => (
          <li class="min-w-0">
            <a
              href={href(lang, `${page.path}/${child.slug}`)}
              class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-stone-200/90 bg-paper shadow-[var(--mission-shadow-soft)] transition-shadow hover:shadow-[var(--mission-shadow-lift)]"
            >
              <span class="aspect-[16/10] block overflow-hidden">
                <PlaceholderArt
                  motif={child.icon ?? "church"}
                  tone="stone"
                  src={(child as any).image ?? cardImages[index % cardImages.length]}
                  alt={tr(child.title, lang)}
                  label={t("replacePhoto", lang)}
                  arch={false}
                  iconSize="28%"
                  className="transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </span>
              <span class="flex flex-1 flex-col p-5">
                <span class="font-heading text-2xl text-ink">{tr(child.title, lang)}</span>
                <span class="mt-2 flex-1 text-ink-600">{tr(child.description, lang)}</span>
                <span class="mt-5 inline-flex items-center gap-1.5 font-tradition text-blue">
                  {t("explore", lang)}
                  <ArrowRight aria-hidden="true" className="size-4 transition-transform group-hover:translate-x-1 rtl:rotate-180 rtl:group-hover:-translate-x-1" />
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </SectionShell>
  )
}
