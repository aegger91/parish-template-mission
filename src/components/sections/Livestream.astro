---
import { ExternalLink, Radio } from "lucide-react"
import SectionShell from "./SectionShell.astro"
import { OrthodoxCross } from "@/components/brand/OrthodoxCross"
import { buttonVariants } from "@/components/ui/button"
import { site, t, tr, langInfo, isFeatureOn, type SectionNode } from "@/lib/site"
import { scheduleData, buildDate } from "@/lib/scheduleData"
import { buildDays, formatDate, formatTime } from "@/lib/calendar"
interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const ls = site.features.livestream
const locale = langInfo(lang).locale
const next = buildDays(buildDate(), 21, scheduleData(lang))
  .flatMap((d) => d.services.filter((s) => s.livestream).map((s) => ({ ...s, date: d.date })))
  .at(0)
---

{
  isFeatureOn("livestream") && (
    <SectionShell id={section.id}>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        <div class="relative aspect-video overflow-hidden rounded-[1.75rem] bg-ink">
          {ls.embedUrl ? (
            <iframe src={ls.embedUrl} title={tr(site.parish.name, lang)} class="absolute inset-0 h-full w-full" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy" />
          ) : (
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center text-white/80">
              <div aria-hidden="true" class="kiot-arch absolute inset-y-[12%] start-1/2 w-[34%] -translate-x-1/2 border border-white/15 rtl:translate-x-1/2" />
              <OrthodoxCross size={56} className="relative text-white/70" />
              <p class="relative max-w-sm text-sm">{t("livestreamPlaceholder", lang)}</p>
            </div>
          )}
          {ls.live && (
            <span class="absolute start-4 top-4 inline-flex items-center gap-2 rounded-full bg-blue px-3 py-1.5 text-xs font-semibold tracking-wide text-white uppercase">
              <span class="size-2 animate-pulse rounded-full bg-white motion-reduce:animate-none" />
              {t("liveNow", lang)}
            </span>
          )}
        </div>
        <div class="min-w-0 space-y-5">
          <div class="rounded-[1.5rem] border border-border p-6">
            <p class="eyebrow">{ls.live ? t("liveNow", lang) : t("nextStream", lang)}</p>
            {!ls.live && <p class="mt-3 text-ink-600">{t("livestreamOffline", lang)}</p>}
            {next && (
              <div class="mt-4">
                <p class="text-sm text-ink-500">{t("nextStream", lang)}</p>
                <p class="mt-1 font-heading text-xl text-ink">{next.title}</p>
                <p class="text-ink-600">
                  {formatDate(next.date, locale, { weekday: "long", month: "long", day: "numeric" })}, {formatTime(next.time, locale)}
                </p>
              </div>
            )}
            <a href={ls.watchUrl} target="_blank" rel="noopener" class={buttonVariants({ className: "mt-6 w-full" })}>
              <Radio aria-hidden="true" />
              {t("openStream", lang, { platform: ls.platform })}
              <ExternalLink aria-hidden="true" className="size-3.5" />
            </a>
          </div>
        </div>
      </div>
    </SectionShell>
  )
}
