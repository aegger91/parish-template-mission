---
import { OrthodoxCross } from "@/components/brand/OrthodoxCross"
import { buttonVariants } from "@/components/ui/button"
import { tr, t, specialPageHref, type SectionNode } from "@/lib/site"
interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const donateHref = specialPageHref("donate", lang)
---

{
  donateHref && (
    <section id={section.id} class="relative overflow-hidden bg-ink-band py-16 text-white md:py-24">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgb(36_53_82)_0%,_transparent_55%)]" />
      <div class="container-mission relative">
        <div class="mx-auto max-w-3xl text-center">
          <div class="section-ornament justify-center text-gold" aria-hidden="true">
            <OrthodoxCross size={28} />
          </div>
          <h2 class="mt-6 text-3xl leading-tight text-white md:text-[2.75rem]">{tr(section.title, lang)}</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/80">{tr(section.text, lang)}</p>
          <a href={donateHref} class={buttonVariants({ size: "lg", className: "mt-8 border-transparent bg-gold text-ink hover:bg-gold-wash shadow-none" })}>
            {t("donateNow", lang)}
          </a>
        </div>
      </div>
    </section>
  )
}
