---
import { Car, Bus, Navigation } from "lucide-react"
import SectionShell from "./SectionShell.astro"
import MapPanel from "./MapPanel.astro"
import { buttonVariants } from "@/components/ui/button"
import { site, tr, t, formatAddressLines, type SectionNode } from "@/lib/site"
interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const c = site.contact
---

<SectionShell id={section.id} tone="stone" eyebrow={t("directions", lang)} title={formatAddressLines(lang)[0]}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <MapPanel lang={lang} />
    <div class="min-w-0 space-y-6">
      <address class="font-tradition text-xl leading-relaxed not-italic text-ink">
        {formatAddressLines(lang).map((l) => <span class="block">{l}</span>)}
      </address>
      <a href={c.directionsUrl} target="_blank" rel="noopener" class={buttonVariants({ size: "lg" })}>
        <Navigation aria-hidden="true" />
        {t("getDirections", lang)}
      </a>
      <dl class="space-y-4 text-ink-700">
        <div class="flex gap-3"><Car aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-gold" /><div><dt class="font-semibold">{t("parking", lang)}</dt><dd>{tr(c.parking, lang)}</dd></div></div>
        <div class="flex gap-3"><Bus aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-gold" /><div><dt class="font-semibold">{t("transit", lang)}</dt><dd>{tr(c.transit, lang)}</dd></div></div>
      </dl>
    </div>
  </div>
</SectionShell>
