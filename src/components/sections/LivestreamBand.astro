---
import { Radio } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { site, tr, t, specialPageHref, isFeatureOn, type SectionNode } from "@/lib/site"
interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const ls = site.features.livestream
const pageHref = specialPageHref("livestream", lang)
const show = isFeatureOn("livestream") && pageHref
---

{
  show && (
    <section id={section.id} class="bg-white py-6 md:py-10">
      <div class="container-mission">
        <div class="relative overflow-hidden rounded-[1.75rem] bg-ink px-6 py-10 text-white md:px-12 md:py-12">
          <div aria-hidden="true" class="kiot-arch absolute end-8 -top-10 hidden h-64 w-48 border border-white/15 md:block" />
          <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="min-w-0 max-w-xl">
              {ls.live && (
                <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tracking-wide uppercase">
                  <span class="size-2 rounded-full bg-[#7fa6e6]" />
                  {t("liveNow", lang)}
                </p>
              )}
              <h2 class="text-3xl leading-tight md:text-4xl">{tr(section.title, lang)}</h2>
              <p class="mt-3 text-lg text-white/75">{tr(section.text, lang)}</p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row">
              <a href={pageHref} class={buttonVariants({ size: "lg", className: "bg-white text-ink hover:bg-stone-100" })}>
                <Radio aria-hidden="true" />
                {ls.live ? t("watchLive", lang) : t("sermonArchive", lang)}
              </a>
              {ls.live && (
                <a href={`${pageHref}#sermon-archive`} class={buttonVariants({ size: "lg", variant: "ghost", className: "text-white hover:bg-white/10 hover:text-white" })}>
                  {t("sermonArchive", lang)}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
