---
import { ArrowRight } from "lucide-react"
import { Pictogram } from "@/components/brand/Pictogram"
import { buttonVariants } from "@/components/ui/button"
import HeroNewcomer from "./HeroNewcomer"
import ThisWeekCard from "./ThisWeekCard"
import { site, tr, strings, langInfo, resolveLink, specialPageHref, isFeatureOn, formatAddressLines, type SectionNode } from "@/lib/site"
import { scheduleData, buildDate } from "@/lib/scheduleData"
import { cn } from "@/lib/utils"

interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const locale = langInfo(lang).locale
const primary = resolveLink(section.primaryCta, lang)
const secondary = resolveLink(section.secondaryCta, lang)
const shortcut = section.shortcut && site.features.zapiski?.showHeroShortcut !== false ? resolveLink(section.shortcut, lang) : null
const items = (section.newcomer?.items ?? []).map((i: any) => ({
  id: i.id,
  label: tr(i.label, lang),
  text: tr(i.text, lang),
  link: i.link ? (resolveLink(i.link, lang) ?? undefined) : undefined,
}))
const live = isFeatureOn("livestream") && site.features.livestream.live ? { href: specialPageHref("livestream", lang) ?? site.features.livestream.watchUrl } : null
const s = strings(lang, [
  "thisWeeksServices",
  "liveNow",
  "today",
  "tomorrow",
  "feastToday",
  "nextFeast",
  "inDays",
  "inOneDay",
  "dailyCalendarNote",
  "getDirections",
  "fullSchedule",
  "streamed",
])
---

<section id={section.id} class="relative overflow-hidden bg-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 end-0 hidden w-[44%] bg-stone-50 lg:block"></div>
  <div aria-hidden="true" class="pointer-events-none absolute end-[6%] top-10 hidden h-[34rem] w-[26rem] border border-gold-line kiot-arch lg:block"></div>
  <div class="container-mission relative grid gap-12 pt-10 pb-16 md:pt-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16 lg:pt-20 lg:pb-24">
    <div class="min-w-0">
      <p class="eyebrow">{tr(section.eyebrow, lang)}</p>
      <h1 class="mt-4 text-[3.1rem] leading-[1.02] text-ink sm:text-[4.2rem] lg:text-[5.2rem]">{tr(section.title, lang)}</h1>
      <div aria-hidden="true" class="hairline-gold-start mt-6 w-48"></div>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600 md:text-xl">{tr(section.lead, lang)}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {primary && <a href={primary.href} class={buttonVariants({ size: "lg" })}>{primary.label}</a>}
        {
          secondary && (
            <a href={secondary.href} class={buttonVariants({ variant: "outline", size: "lg" })}>
              {secondary.label}
            </a>
          )
        }
      </div>
      <div class="mt-10 max-w-xl">
        <HeroNewcomer client:visible title={tr(section.newcomer?.title, lang)} items={items} />
      </div>
      {
        shortcut && (
          <a href={shortcut.href} class="group mt-6 inline-flex max-w-full items-center gap-3 rounded-full border border-border bg-white py-1.5 ps-1.5 pe-4 text-[0.95rem] text-ink-700 transition-colors hover:border-gold">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-wash text-gold">
              <Pictogram name="slip" size={18} />
            </span>
            <span class="min-w-0 font-tradition">{shortcut.label}</span>
            <ArrowRight aria-hidden="true" className="size-4 shrink-0 text-ink-500 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
          </a>
        )
      }
    </div>
    <div class={cn("min-w-0 lg:pt-6")}>
      <ThisWeekCard
        client:load
        data={scheduleData(lang)}
        initialToday={buildDate()}
        locale={locale}
        highlightRanks={site.calendar.highlightRanks ?? ["great"]}
        s={s}
        scheduleHref={specialPageHref("schedule", lang) ?? "#"}
        directionsUrl={site.contact.directionsUrl}
        addressLines={formatAddressLines(lang)}
        live={live}
        calendarConnected={!!site.orthodoxConnect?.calendar?.enabled}
      />
    </div>
  </div>
</section>
