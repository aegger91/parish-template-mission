---
import { ArrowRight, Phone, Radio } from "lucide-react"
import { Pictogram } from "@/components/brand/Pictogram"
import { buttonVariants } from "@/components/ui/button"
import ThisWeekCard from "./ThisWeekCard"
import { site, tr, t, strings, langInfo, resolveLink, specialPageHref, isFeatureOn, formatAddressLines, type SectionNode } from "@/lib/site"
import { scheduleData, buildDate } from "@/lib/scheduleData"
import imagesJson from "@content/images.json"

interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const locale = langInfo(lang).locale
const primary = resolveLink(section.primaryCta, lang)
const secondary = resolveLink(section.secondaryCta, lang)
const shortcut = section.shortcut && site.features.zapiski?.showHeroShortcut !== false ? resolveLink(section.shortcut, lang) : null
const livestreamOn = isFeatureOn("livestream")
const isLive = livestreamOn && !!site.features.livestream.live
const livestreamHref = specialPageHref("livestream", lang) ?? site.features.livestream?.watchUrl
const live = isLive ? { href: livestreamHref } : null
const phone: string | undefined = site.contact.phone
const s = strings(lang, [
  "thisWeeksServices",
  "liveNow",
  "today",
  "tomorrow",
  "feastToday",
  "nextFeast",
  "inDays",
  "inOneDay",
  "dailyCalendarNote",
  "getDirections",
  "fullSchedule",
  "streamed",
])
const heroImage = (section.image as string | undefined) || (imagesJson as any).hero?.src
const heroAlt = tr(section.imageAlt ?? (imagesJson as any).hero?.alt, lang) || tr((imagesJson as any).hero?.alt, lang)
const replaceLabel = t("replacePhoto", lang)
const pill = "inline-flex max-w-full items-center gap-2.5 rounded-full border border-white/25 bg-white/10 py-1.5 ps-1.5 pe-4 text-[0.95rem] text-white/95 backdrop-blur-sm transition-colors hover:border-gold hover:bg-white/15"
---

<section id={section.id} class="relative isolate overflow-hidden">
  {
    heroImage && (
      <div class="absolute inset-0 -z-10">
        <img src={heroImage} alt="" aria-hidden="true" class="h-full w-full object-cover object-[50%_40%]" fetchpriority="high" width="1920" height="1080" />
        <div aria-hidden="true" class="hero-overlay absolute inset-0" />
      </div>
    )
  }
  {
    !heroImage && (
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-ink-band">
        <div class="hero-overlay absolute inset-0" />
      </div>
    )
  }
  <span class="sr-only">{heroAlt}</span>
  <div class="container-mission relative grid gap-12 pt-12 pb-16 md:pt-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:pt-20 lg:pb-24">
    <div class="min-w-0 reveal-fade">
      {section.eyebrow && <p class="font-tradition text-sm tracking-[0.22em] text-[#e0bc6a] uppercase">{tr(section.eyebrow, lang)}</p>}
      <h1 class="mt-4 text-[3rem] leading-[1.04] text-white sm:text-[4rem] lg:text-[4.8rem]">{tr(section.title, lang)}</h1>
      <div aria-hidden="true" class="mt-6 h-px w-48 bg-gradient-to-r from-gold-line to-transparent"></div>
      {section.lead && <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/88 md:text-xl">{tr(section.lead, lang)}</p>}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {primary && <a href={primary.href} class={buttonVariants({ size: "lg", className: "bg-gold text-ink hover:bg-gold-wash border-transparent shadow-none" })}>{primary.label}</a>}
        {
          secondary && (
            <a href={secondary.href} class={buttonVariants({ variant: "outline", size: "lg", className: "border-white/40 bg-transparent text-white hover:border-white hover:bg-white/10" })}>
              {secondary.label}
            </a>
          )
        }
      </div>
      <ul class="mt-10 flex flex-wrap gap-3">
        {
          livestreamOn && livestreamHref && (
            <li class="max-w-full">
              <a href={livestreamHref} class={pill}>
                <span class:list={["flex size-8 shrink-0 items-center justify-center rounded-full", isLive ? "bg-blue text-white" : "bg-white/15 text-white"]}>
                  <Radio aria-hidden="true" className="size-4" />
                </span>
                <span class="min-w-0 font-tradition">{isLive ? t("liveNow", lang) : t("watchLive", lang)}</span>
                {isLive && <span aria-hidden="true" class="size-2 shrink-0 animate-pulse rounded-full bg-[#9ec0ff]" />}
              </a>
            </li>
          )
        }
        {
          phone && (
            <li class="max-w-full">
              <a href={`tel:${phone.replace(/[^\d+]/g, "")}`} class={pill}>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white/15 text-white">
                  <Phone aria-hidden="true" className="size-4" />
                </span>
                <span class="min-w-0 font-tradition tabular-nums">{phone}</span>
              </a>
            </li>
          )
        }
        {
          shortcut && (
            <li class="max-w-full">
              <a href={shortcut.href} class:list={[pill, "group"]}>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gold/25 text-gold-wash">
                  <Pictogram name="slip" size={18} />
                </span>
                <span class="min-w-0 font-tradition">{shortcut.label}</span>
                <ArrowRight aria-hidden="true" className="size-4 shrink-0 text-white/70 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
              </a>
            </li>
          )
        }
      </ul>
      <p class="mt-6 text-xs tracking-wide text-white/75 uppercase">{replaceLabel}</p>
    </div>
    <div class="min-w-0 reveal-fade-delay">
      <ThisWeekCard
        client:load
        data={scheduleData(lang)}
        initialToday={buildDate()}
        locale={locale}
        highlightRanks={site.calendar.highlightRanks ?? ["great"]}
        s={s}
        scheduleHref={specialPageHref("schedule", lang) ?? "#"}
        directionsUrl={site.contact.directionsUrl}
        addressLines={formatAddressLines(lang)}
        live={live}
        calendarConnected={!!site.orthodoxConnect?.calendar?.enabled}
      />
    </div>
  </div>
</section>
