---
import { ArrowRight, Phone, Radio } from "lucide-react"
import { Pictogram } from "@/components/brand/Pictogram"
import { buttonVariants } from "@/components/ui/button"
import ThisWeekCard from "./ThisWeekCard"
import { site, tr, t, strings, langInfo, resolveLink, specialPageHref, isFeatureOn, formatAddressLines, type SectionNode } from "@/lib/site"
import { scheduleData, buildDate } from "@/lib/scheduleData"

interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const locale = langInfo(lang).locale
const primary = resolveLink(section.primaryCta, lang)
const secondary = resolveLink(section.secondaryCta, lang)
const shortcut = section.shortcut && site.features.zapiski?.showHeroShortcut !== false ? resolveLink(section.shortcut, lang) : null
const livestreamOn = isFeatureOn("livestream")
const isLive = livestreamOn && !!site.features.livestream.live
const livestreamHref = specialPageHref("livestream", lang) ?? site.features.livestream?.watchUrl
const live = isLive ? { href: livestreamHref } : null
const phone: string | undefined = site.contact.phone
const s = strings(lang, [
  "thisWeeksServices",
  "liveNow",
  "today",
  "tomorrow",
  "feastToday",
  "nextFeast",
  "inDays",
  "inOneDay",
  "dailyCalendarNote",
  "getDirections",
  "fullSchedule",
  "streamed",
])
const pill = "inline-flex max-w-full items-center gap-2.5 rounded-full border border-border bg-white py-1.5 ps-1.5 pe-4 text-[0.95rem] text-ink-700 transition-colors hover:border-gold"
---

<section id={section.id} class="relative overflow-hidden bg-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 end-0 hidden w-[44%] bg-stone-50 lg:block"></div>
  <div aria-hidden="true" class="pointer-events-none absolute end-[6%] top-10 hidden h-[34rem] w-[26rem] border border-gold-line kiot-arch lg:block"></div>
  <div class="container-mission relative grid gap-12 pt-10 pb-16 md:pt-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:pt-16 lg:pb-20">
    <div class="min-w-0">
      {section.eyebrow && <p class="eyebrow">{tr(section.eyebrow, lang)}</p>}
      <h1 class="mt-4 text-[3rem] leading-[1.04] text-ink sm:text-[4rem] lg:text-[4.8rem]">{tr(section.title, lang)}</h1>
      <div aria-hidden="true" class="hairline-gold-start mt-6 w-48"></div>
      {section.lead && <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600 md:text-xl">{tr(section.lead, lang)}</p>}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {primary && <a href={primary.href} class={buttonVariants({ size: "lg" })}>{primary.label}</a>}
        {
          secondary && (
            <a href={secondary.href} class={buttonVariants({ variant: "outline", size: "lg" })}>
              {secondary.label}
            </a>
          )
        }
      </div>
      <ul class="mt-10 flex flex-wrap gap-3">
        {
          livestreamOn && livestreamHref && (
            <li class="max-w-full">
              <a href={livestreamHref} class={pill}>
                <span class:list={["flex size-8 shrink-0 items-center justify-center rounded-full", isLive ? "bg-blue text-white" : "bg-blue-wash text-blue"]}>
                  <Radio aria-hidden="true" className="size-4" />
                </span>
                <span class="min-w-0 font-tradition">{isLive ? t("liveNow", lang) : t("watchLive", lang)}</span>
                {isLive && <span aria-hidden="true" class="size-2 shrink-0 animate-pulse rounded-full bg-blue" />}
              </a>
            </li>
          )
        }
        {
          phone && (
            <li class="max-w-full">
              <a href={`tel:${phone.replace(/[^\d+]/g, "")}`} class={pill}>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-ink-700">
                  <Phone aria-hidden="true" className="size-4" />
                </span>
                <span class="min-w-0 font-tradition tabular-nums">{phone}</span>
              </a>
            </li>
          )
        }
        {
          shortcut && (
            <li class="max-w-full">
              <a href={shortcut.href} class:list={[pill, "group"]}>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-wash text-gold">
                  <Pictogram name="slip" size={18} />
                </span>
                <span class="min-w-0 font-tradition">{shortcut.label}</span>
                <ArrowRight aria-hidden="true" className="size-4 shrink-0 text-ink-500 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />
              </a>
            </li>
          )
        }
      </ul>
    </div>
    <div class="min-w-0">
      <ThisWeekCard
        client:load
        data={scheduleData(lang)}
        initialToday={buildDate()}
        locale={locale}
        highlightRanks={site.calendar.highlightRanks ?? ["great"]}
        s={s}
        scheduleHref={specialPageHref("schedule", lang) ?? "#"}
        directionsUrl={site.contact.directionsUrl}
        addressLines={formatAddressLines(lang)}
        live={live}
        calendarConnected={!!site.orthodoxConnect?.calendar?.enabled}
      />
    </div>
  </div>
</section>
