---
import { CalendarPlus, HandHelping, ExternalLink } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { t, connectLink, type SectionNode } from "@/lib/site"
interface Props {
  lang: string
  section: SectionNode
}
const { lang, section } = Astro.props
const actions: string[] = section.actions ?? ["createEvent", "postNeed"]
---

<section id={section.id} class="border-b border-border bg-white">
  <div class="container-mission flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-between">
    <p class="flex max-w-2xl items-start gap-3 text-ink-600">
      <span class="mt-1 inline-flex shrink-0 items-center rounded-full border border-blue-line bg-blue-wash px-2.5 py-0.5 text-xs font-semibold text-blue-deep">OrthodoxConnect</span>
      <span>{t("connectIntro", lang)}</span>
    </p>
    <div class="flex flex-col gap-2 sm:flex-row">
      {
        actions.map((a) => (
          <a href={connectLink(a)} rel="noopener" title={t("connectHandoff", lang)} class={buttonVariants({ variant: a === "createEvent" ? "default" : "outline", size: "sm" })}>
            {a === "createEvent" ? <CalendarPlus aria-hidden="true" /> : <HandHelping aria-hidden="true" />}
            {t(a, lang)}
            <ExternalLink aria-hidden="true" className="size-3.5 opacity-70" />
          </a>
        ))
      }
    </div>
  </div>
</section>
