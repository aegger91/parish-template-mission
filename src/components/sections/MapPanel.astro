---
import { Pictogram } from "@/components/brand/Pictogram"
import { site, t, tr } from "@/lib/site"
interface Props {
  lang: string
}
const { lang } = Astro.props
const embed = site.contact.mapEmbedUrl as string | null
const name = tr(site.parish.name, lang)
---

<div class="relative min-h-[20rem] overflow-hidden rounded-[1.75rem] border border-border bg-white">
  {
    embed ? (
      <iframe src={embed} title={name} class="absolute inset-0 h-full w-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
    ) : (
      <div role="img" aria-label={t("mapPlaceholder", lang)} class="absolute inset-0">
        <svg class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid slice" viewBox="0 0 600 400" aria-hidden="true">
          <rect width="600" height="400" fill="#f6f4ef" />
          <g stroke="#e3ded3" stroke-width="18" fill="none" stroke-linecap="round">
            <path d="M-20 120 H620" />
            <path d="M-20 300 C150 280 260 330 620 270" />
            <path d="M180 -20 V420" />
            <path d="M430 -20 C410 140 470 260 440 420" />
          </g>
          <g stroke="#ebe7de" stroke-width="8" fill="none">
            <path d="M-20 210 H620" />
            <path d="M300 -20 V420" />
            <path d="M60 -20 V420" />
            <path d="M540 -20 V420" />
          </g>
          <rect x="320" y="140" width="90" height="54" rx="6" fill="#eef3fa" stroke="#c9d6ea" />
          <rect x="200" y="226" width="80" height="60" rx="6" fill="#efece4" />
          <rect x="70" y="140" width="96" height="56" rx="6" fill="#efece4" />
          <circle cx="250" cy="170" r="60" fill="#24519a" opacity="0.06" />
        </svg>
        <div class="absolute start-1/2 top-[42.5%] -translate-x-1/2 -translate-y-full rtl:translate-x-1/2">
          <div class="flex flex-col items-center">
            <span class="flex size-14 items-center justify-center rounded-full border-2 border-white bg-blue text-white shadow-[var(--mission-shadow-lift)]">
              <Pictogram name="church" size={30} strokeWidth={1.4} />
            </span>
            <span class="h-3 w-0.5 bg-blue"></span>
          </div>
        </div>
        <p class="absolute inset-x-4 bottom-4 rounded-xl bg-white/90 px-3 py-2 text-center text-xs text-ink-500 backdrop-blur-sm">{t("mapPlaceholder", lang)}</p>
      </div>
    )
  }
</div>
