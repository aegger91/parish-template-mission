{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Photo gallery",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "categories": { "$ref": "common.schema.json#/definitions/categories" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "category": { "$ref": "common.schema.json#/definitions/id" },
          "motif": { "$ref": "common.schema.json#/definitions/motif" },
          "tone": { "$ref": "common.schema.json#/definitions/tone" },
          "shape": { "enum": ["wide", "tall", "square"] },
          "src": { "$ref": "common.schema.json#/definitions/imageSrc" },
          "caption": { "$ref": "common.schema.json#/definitions/localized" }
        },
        "required": ["id", "category", "caption"],
        "additionalProperties": false
      }
    }
  },
  "required": ["categories", "items"]
}
