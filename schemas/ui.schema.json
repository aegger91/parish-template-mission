{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interface wording",
  "description": "Every button, label and message on the site. Words in {braces} are filled in automatically; keep them.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "strings": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/definitions/localized" }
    }
  },
  "required": ["strings"],
  "additionalProperties": false
}
