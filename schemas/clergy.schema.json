{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clergy and those who serve",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "name": { "$ref": "common.schema.json#/definitions/localized" },
          "role": { "$ref": "common.schema.json#/definitions/localized" },
          "initials": { "type": "string", "maxLength": 3 },
          "photo": { "$ref": "common.schema.json#/definitions/imageSrc" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "summary": { "$ref": "common.schema.json#/definitions/localized" },
          "bio": { "$ref": "common.schema.json#/definitions/localizedList" }
        },
        "required": ["id", "name", "role", "initials"],
        "additionalProperties": false
      }
    }
  },
  "required": ["people"]
}
