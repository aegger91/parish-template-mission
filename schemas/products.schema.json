{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Store products",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "categories": { "$ref": "common.schema.json#/definitions/categories" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "slug": { "$ref": "common.schema.json#/definitions/slug" },
          "category": { "$ref": "common.schema.json#/definitions/id" },
          "featured": { "type": "boolean" },
          "pickupOnly": { "type": "boolean", "description": "Too fragile or large to ship; checkout switches to pickup." },
          "title": { "$ref": "common.schema.json#/definitions/localized" },
          "summary": { "$ref": "common.schema.json#/definitions/localized" },
          "description": { "$ref": "common.schema.json#/definitions/localizedList" },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": { "$ref": "common.schema.json#/definitions/imageSrc" },
                "motif": { "$ref": "common.schema.json#/definitions/motif" },
                "tone": { "$ref": "common.schema.json#/definitions/tone" },
                "alt": { "$ref": "common.schema.json#/definitions/localized" }
              },
              "required": ["alt"],
              "additionalProperties": false
            }
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "common.schema.json#/definitions/id" },
                "label": { "$ref": "common.schema.json#/definitions/localized" },
                "price": { "$ref": "common.schema.json#/definitions/money" },
                "stock": { "type": "integer", "minimum": 0 },
                "sku": { "type": "string" }
              },
              "required": ["id", "label", "price", "stock"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "slug", "category", "title", "summary", "variants"],
        "additionalProperties": false
      }
    }
  },
  "required": ["categories", "products"]
}
